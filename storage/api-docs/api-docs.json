                                        "$ref": "#/components/schemas/ContentResource"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/page": {
            "get": {
                "tags": [
                    "Content"
                ],
                "summary": "Получить список страниц",
                "operationId": "742dc9712b8debf20a7a8bbdf970f6bc",
                "responses": {
                    "200": {
                        "description": "Список страниц",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/ContentResource"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/system": {
            "get": {
                "tags": [
                    "Content"
                ],
                "summary": "Получить список системных страниц",
                "operationId": "1e7e5110b7f9119f0fd96a5c99129694",
                "responses": {
                    "200": {
                        "description": "Список системных страниц",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/ContentResource"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/content": {
            "get": {
                "tags": [
                    "Content"
                ],
                "summary": "Получить список материалов",
                "operationId": "0be08af6ce2d10b06212bdfaf96ca96e",
                "responses": {
                    "200": {
                        "description": "Список материалов",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/ContentResource"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/products": {
            "get": {
                "tags": [
                    "Products"
                ],
                "summary": "Получить список всех товаров",
                "operationId": "e422a6932f9da90d47891a91e88effc1",
                "parameters": [
                    {
                        "name": "filter[category_id]",
                        "in": "query",
                        "description": "Фильтр по ID категории (можно передать несколько через запятую)",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "filter[category_name]",
                        "in": "query",
                        "description": "Фильтр по названию категории (частичное совпадение)",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "filter[category_full_path]",
                        "in": "query",
                        "description": "Фильтр по полному пути категории (точное совпадение)",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Список товаров",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/ProductResource"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/products/{id}": {
            "get": {
                "tags": [
                    "Products"
                ],
                "summary": "Получить информацию о товаре по ID",
                "operationId": "bf64c626ced82f402f00356b4078b07c",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Информация о товаре",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProductResource"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Товар не найден"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "CategoryDTO": {
                "required": [
                    "name",
                    "slug"
                ],
                "properties": {
                    "parent_id": {
                        "type": "integer",
                        "example": 1,
                        "nullable": true
                    },
                    "name": {
                        "type": "string",
                        "example": "Газовое оборудование"
                    },
                    "slug": {
                        "type": "string",
                        "example": "gazovoe-oborudovanie"
                    },
                    "status": {
                        "type": "string",
                        "example": "active"
                    },
                    "description": {
                        "type": "string",
                        "example": "Описание категории",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "ContentDTO": {
                "required": [
                    "type",
                    "name",
                    "slug"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "type": {
                        "type": "string",
                        "example": "blog"
                    },
                    "name": {
                        "type": "string",
                        "example": "Заголовок контента"
                    },
                    "slug": {
                        "type": "string",
                        "example": "zagolovok-kontenta"
                    },
                    "category_id": {
                        "type": "integer",
                        "example": 1,
                        "nullable": true
                    },
                    "short_text": {
                        "type": "string",
                        "example": "Краткий текст",
                        "nullable": true
                    },
                    "full_text": {
                        "type": "string",
                        "example": "Полный текст контента",
                        "nullable": true
                    },
                    "views": {
                        "type": "integer",
                        "example": 100
                    },
                    "tags": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "tag1",
                            "tag2"
                        ]
                    }
                },
                "type": "object"
            },
            "ProductDTO": {
                "required": [
                    "category_id",
                    "name",
                    "slug"
                ],
                "properties": {
                    "category_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "Газовый котел"
                    },
                    "slug": {
                        "type": "string",
                        "example": "gazoviy-kotel"
                    },
                    "description": {
                        "type": "string",
                        "example": "Описание товара",
                        "nullable": true
                    },
                    "attributes": {
                        "type": "object",
                        "example": {
                            "power": "24kW"
                        },
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "CategoryResource": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "parent_id": {
                        "type": "integer",
                        "example": null,
                        "nullable": true
                    },
                    "name": {
                        "type": "string",
                        "example": "Газовое оборудование"
                    },
                    "slug": {
                        "type": "string",
                        "example": "gazovoe-oborudovanie"
                    },
                    "full_path": {
                        "type": "string",
                        "example": "oborudovanie/gazovoe-oborudovanie"
                    },
                    "status": {
                        "type": "string",
                        "example": "active"
                    },
                    "description": {
                        "type": "string",
                        "example": "Описание категории",
                        "nullable": true
                    },
                    "children": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/CategoryResource"
                        },
                        "nullable": true
                    },
                    "products_count": {
                        "type": "integer",
                        "example": 5,
                        "nullable": true
                    },
                    "cover_url": {
                        "type": "string",
                        "example": "http://localhost/storage/1/conversions/image-cover.jpg",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "ContentResource": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "type": {
                        "type": "string",
                        "example": "blog"
                    },
                    "name": {
                        "type": "string",
                        "example": "Заголовок контента"
                    },
                    "slug": {
                        "type": "string",
                        "example": "zagolovok-kontenta"
                    },
                    "category_id": {
                        "type": "integer",
                        "example": 1,
                        "nullable": true
                    },
                    "short_text": {
                        "type": "string",
                        "example": "Краткий текст",
                        "nullable": true
                    },
                    "full_text": {
                        "type": "string",
                        "example": "Полный текст контента",
                        "nullable": true
                    },
                    "views": {
                        "type": "integer",
                        "example": 100
                    },
                    "tags": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "tag1",
                            "tag2"
                        ]
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "type": "object"
            },
            "ProductResource": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "category_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "category_full_path": {
                        "type": "string",
                        "example": "oborudovanie/gazovoe-oborudovanie",
                        "nullable": true
                    },
                    "name": {
                        "type": "string",
                        "example": "Газовый котел"
                    },
                    "slug": {
                        "type": "string",
                        "example": "gazoviy-kotel"
                    },
                    "description": {
                        "type": "string",
                        "example": "Описание товара",
                        "nullable": true
                    },
                    "attributes": {
                        "type": "object",
                        "example": {
                            "power": "24kW"
                        }
                    },
                    "cover_url": {
                        "type": "string",
                        "example": "http://localhost/storage/1/conversions/image-cover.jpg",
                        "nullable": true
                    }
                },
                "type": "object"
            }
        }
    },
    "tags": [
        {
            "name": "Categories",
            "description": "Управление категориями"
        },
        {
            "name": "Content",
            "description": "Управление контентом"
        },
        {
            "name": "Products",
            "description": "Управление товарами"
