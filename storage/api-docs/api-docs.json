{
    "openapi": "3.0.0",
    "info": {
        "title": "Shop GazTochka API",
        "description": "Документация API для интернет-магазина ГазТочка",
        "contact": {
            "email": "admin@gaztochka.ru"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost",
            "description": "Основной сервер API"
        }
    ],
    "paths": {
        "/api/health": {
            "get": {
                "tags": [
                    "System"
                ],
                "summary": "Проверка работоспособности API",
                "operationId": "eafb61167d2639c57d4815f1769012fe",
                "responses": {
                    "200": {
                        "description": "API работает корректно",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "ok"
                                        },
                                        "timestamp": {
                                            "type": "string",
                                            "format": "date-time"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/categories": {
            "get": {
                "tags": [
                    "Categories"
                ],
                "summary": "Получить список всех категорий",
                "operationId": "4aed8169864e0b796b0ca9e85d852c15",
                "parameters": [
                    {
                        "name": "filter[id]",
                        "in": "query",
                        "description": "Фильтр по ID (можно передать несколько через запятую)",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "filter[name]",
                        "in": "query",
                        "description": "Фильтр по названию (частичное совпадение)",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "filter[slug]",
                        "in": "query",
                        "description": "Фильтр по слагу (точное совпадение)",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "filter[full_path]",
                        "in": "query",
                        "description": "Фильтр по полному пути (точное совпадение)",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "include",
                        "in": "query",
                        "description": "Включить связанные данные (доступно: products)",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Список категорий",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/CategoryResource"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/categories/tree": {
            "get": {
                "tags": [
                    "Categories"
                ],
                "summary": "Получить дерево категорий",
                "operationId": "7728c4e7d806b26b15fd6c9f425f8d27",
                "responses": {
                    "200": {
                        "description": "Дерево категорий",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/CategoryResource"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/categories/{id}": {
            "get": {
                "tags": [
                    "Categories"
                ],
                "summary": "Получить информацию о категории по ID",
                "operationId": "be0aa803b4ba569796f0d43b6a77b08a",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "include",
                        "in": "query",
                        "description": "Включить связанные данные (доступно: products)",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Информация о категории",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CategoryResource"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Категория не найдена"
                    }
                }
            }
        },
        "/api/v1/categories/{id}/breadcrumbs": {
            "get": {
                "tags": [
                    "Categories"
                ],
                "summary": "Получить хлебные крошки для категории",
                "operationId": "0eb308641c10287565eb33ffaf41a7a5",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Хлебные крошки",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/CategoryResource"
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Категория не найдена"
                    }
                }
            }
        },
        "/api/v1/categories/{id}/products": {
            "get": {
                "tags": [
                    "Categories"
                ],
                "summary": "Получить товары категории (включая подкатегории)",
                "operationId": "6f4a8e88fadf2eb10abe916f0c80c7b4",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "include_children",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "boolean",
                            "default": true
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Список товаров",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/ProductResource"
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Категория не найдена"
                    }
                }
            }
        },
        "/api/v1/blog": {
            "get": {
                "tags": [
                    "Content"
                ],
                "summary": "Получить список постов блога",
                "operationId": "cdfb88f09a4f573bcf3e7a8327b85de3",
                "responses": {
                    "200": {
                        "description": "Список постов",
                        "content": {
                            "application/json": {
